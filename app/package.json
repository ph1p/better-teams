{
  "name": "better-teams-app",
  "version": "1.9.0",
  "private": true,
  "description": "A calmer, Slack-like overlay inside the new Microsoft Teams desktop app (macOS)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "../better-teams dev",
    "mock": "vite --mode mock",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "lint": "cd .. && oxlint",
    "fmt": "cd .. && oxfmt",
    "fmt:check": "cd .. && oxfmt --check"
  },
  "dependencies": {
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.23.0"
}
