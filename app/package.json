{
  "name": "teams-calm-app",
  "version": "0.1.0",
  "private": true,
  "description": "A calmer, Slack-like overlay inside the new Microsoft Teams desktop app (macOS)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "../teams-calm dev",
    "mock": "vite --mode mock",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "lint": "cd .. && oxlint",
    "fmt": "cd .. && oxfmt",
    "fmt:check": "cd .. && oxfmt --check"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^1.29.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.6.0"
