#!/usr/bin/env bash
# better-teams — run the Better Teams overlay inside the new Microsoft Teams client.
#
# How: Teams ships local JS (Contents/Resources/client-bindings/bundle.js) that
# it runs in a hidden host page; every visible window is opened from there.
# `patch` appends the overlay to that file (needs sudo, the app is root-owned),
# so Teams loads it by itself — no debug port, no injection step.
#
# Two layouts: a source checkout (app/ next to this script; builds with Node)
# and a release install (~/.better-teams from install.sh: a prebuilt payload,
# no Node needed).
#
# Patching breaks the app's code signature seal (`codesign --verify` fails);
# `unpatch` restores the exact original bytes. A Teams update overwrites the
# patch — run `better-teams` again afterwards.
#
# `dev` is different: it relaunches Teams with a DevTools port (9222) and
# hot-reloads the overlay over CDP on every save. While that port is open, any
# local process can control your signed-in Teams session. Leaving `dev`
# (Ctrl-C) relaunches Teams without the port.
#
# Toggle the overlay with Option+Cmd+T.

set -euo pipefail

# Resolve this script's real location even when invoked via a (relative)
# symlink, e.g. ~/.local/bin/better-teams.
SELF="$0"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
DIR="$(cd "$(dirname "$SELF")" && pwd)"
SELF="$DIR/$(basename "$SELF")"

# Release install: prebuilt payload next to this script, no app/ sources.
PREBUILT=0
[ -f "$DIR/app/package.json" ] || PREBUILT=1
if [ "$PREBUILT" = 1 ]; then VERSION="$(cat "$DIR/VERSION" 2>/dev/null || true)"
else VERSION="$(sed -n 's/^  "version": "\(.*\)",$/\1/p' "$DIR/app/package.json" 2>/dev/null | head -1)"; fi
# How to call this script in messages (it is not on PATH).
ME="${SELF/#$HOME/~}"
INSTALL_URL="https://github.com/ph1p/better-teams/releases/latest/download/install.sh"
PORT=9222
APP="Microsoft Teams"
TEAMS_APP="/Applications/$APP.app"
TARGET="$TEAMS_APP/Contents/Resources/client-bindings/bundle.js"
BACKUP_DIR="/Library/Application Support/better-teams"   # root-owned copy of Teams' original bundle.js while patched
TESTED="26289"                       # Teams build line the patch was verified on
NODE_MIN=20                          # vite 6 / tailwind 4
NODE_DEV_MIN=22                      # dev mode uses Node's global WebSocket
BUNDLE="$DIR/app/dist/better-teams-app.js"
PAYLOAD="$DIR/app/dist/better-teams-host.js"
[ "$PREBUILT" = 1 ] && PAYLOAD="$DIR/better-teams-host.js"
DEV_BUNDLE="$DIR/app/dist-dev/better-teams-app.js"
MARK='/*better-teams:begin*/'
# Marker of builds from before the rename: still found, so an old patch is
# replaced instead of a second overlay appended.
OLD_MARK='/*teams-calm:begin*/'
# Launchers earlier versions linked into ~/.local/bin; removed on uninstall.
OLD_LINKS=("$HOME/.local/bin/teams-calm" "$HOME/.local/bin/better-teams")

usage() {
  cat <<EOF
better-teams ${VERSION:-} — a calmer client inside the new Microsoft Teams (macOS)

Usage: $ME [command]

  start       Build, patch Teams if needed, restart it (default).
  update      Install the latest release and restart Teams (release install).
  dev         Hot-reload dev mode (source checkout; debug port $PORT while running).
  build       Build the overlay only; Teams is not touched.
  patch       Build + patch, no restart (takes effect on next Teams launch).
  unpatch     Restore Teams' original files.
  off         Unpatch and restart plain Teams if it is running.
  status      Show Teams version, patch state and debug port.
  doctor      Check requirements (macOS, Teams; Node for source checkouts).
  uninstall   Unpatch Teams. A release install deletes itself; a source
              checkout stays (--purge deletes node_modules and build output).
  help        Show this help.

Toggle the overlay inside Teams with Option+Cmd+T.
EOF
}

say()  { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

# ---- root helpers (root_write is shipped to `sudo /bin/bash -c`) -------------

# Byte offset where our payload starts (the "\n" before the marker), or empty.
payload_offset() {
  local off
  off="$(LC_ALL=C grep -abo -F -e "$MARK" -e "$OLD_MARK" "$TARGET" 2>/dev/null | head -1 | cut -d: -f1 || true)"
  if [ -n "$off" ]; then echo $((off - 1)); fi
}

# Runs as root. `run_root_write` sends this function's source to
# `sudo /bin/bash -c`, so root reads nothing the user can edit except the
# payload on stdin. Self-contained: no other helper exists on the root side.
# Args: target mode(patch|restore) backup_dir mark old_mark
# Returns: 0 ok, 2 bad input, 3 original differs from backup,
#          4 write failed (previous bytes put back).
# Writes in place with `cat >` so bundle.js keeps its owner, mode and inode
# and no stray file lands inside the signed .app.
root_write() {
  local target="$1" mode="$2" backup="$3" mark="$4" old_mark="$5"
  local work off want have
  case "$mode" in patch | restore) ;; *) echo "bad mode: $mode" >&2; return 2 ;; esac
  if [ ! -f "$target" ] || [ -L "$target" ]; then echo "not a regular file: $target" >&2; return 2; fi
  work="$(mktemp -d /tmp/better-teams-root.XXXXXX)"
  # Expand $work now: it is local, so it is already gone when the EXIT trap runs.
  trap "rm -rf '$work'" EXIT
  cat "$target" > "$work/old"

  # Original bytes = everything before the "\n" that precedes the marker.
  off="$(LC_ALL=C grep -abo -F -e "$mark" -e "$old_mark" "$work/old" | head -1 | cut -d: -f1 || true)"
  if [ -n "$off" ]; then head -c "$((off - 1))" "$work/old" > "$work/prefix"
  else cp "$work/old" "$work/prefix"; fi

  if [ "$mode" = restore ] && [ -z "$off" ]; then return 0; fi

  # While patched, the prefix must equal the original saved at patch time.
  if [ -n "$off" ] && [ -f "$backup/bundle.js.orig.sha256" ]; then
    want="$(cut -d' ' -f1 "$backup/bundle.js.orig.sha256")"
    have="$(shasum -a 256 "$work/prefix" | cut -d' ' -f1)"
    if [ "$want" != "$have" ]; then echo "original bytes differ from $backup" >&2; return 3; fi
  fi

  cp "$work/prefix" "$work/new"
  want=$(( $(wc -c < "$work/prefix") ))
  if [ "$mode" = patch ]; then
    cat > "$work/payload"
    if ! LC_ALL=C grep -qF "$mark" "$work/payload"; then echo "stdin is not a better-teams payload" >&2; return 2; fi
    cat "$work/payload" >> "$work/new"
    want=$(( want + $(wc -c < "$work/payload") ))
  elif LC_ALL=C grep -qF -e "$mark" -e "$old_mark" "$work/new"; then
    echo "marker still present after restore" >&2; return 2
  fi
  have=$(( $(wc -c < "$work/new") ))
  if [ "$have" -ne "$want" ]; then echo "size mismatch: $have != $want" >&2; return 4; fi

  # Unpatched Teams (first patch, or Teams updated itself): save its bytes.
  if [ "$mode" = patch ] && [ -z "$off" ]; then
    mkdir -p "$backup" && chmod 700 "$backup"
    cp "$work/prefix" "$backup/bundle.js.orig"
    (cd "$backup" && shasum -a 256 bundle.js.orig > bundle.js.orig.sha256)
  fi

  cat "$work/new" > "$target"
  if ! cmp -s "$work/new" "$target"; then
    cat "$work/old" > "$target"
    echo "write to $target did not verify; previous bytes put back" >&2
    return 4
  fi
  if [ "$mode" = restore ]; then rm -rf "$backup"; fi
}

# Run root_write as root. Its source travels as the `bash -c` string, so
# sudo never executes this (user-writable) file.
run_root_write() {
  local mode="$1" src=/dev/null rc=0
  [ "$mode" = patch ] && src="$PAYLOAD"
  sudo /bin/bash -c "set -euo pipefail; $(declare -f root_write); root_write \"\$@\"" \
    better-teams-root "$TARGET" "$mode" "$BACKUP_DIR" "$MARK" "$OLD_MARK" < "$src" || rc=$?
  case "$rc" in
    0) ;;
    2) die "refused to write $TARGET (bad input, see above); Teams left as it was." ;;
    3) die "Teams' bundle.js no longer matches the original saved in $BACKUP_DIR; not touching it. Reinstall Teams to recover." ;;
    4) die "writing $TARGET failed; the previous file was put back." ;;
    *) die "root write failed (exit $rc); Teams left as it was." ;;
  esac
}

# ---- checks ------------------------------------------------------------------

teams_version() { defaults read "$TEAMS_APP/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || echo "?"; }
node_major() { node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0; }

need_teams() {
  [ "$(uname -s)" = Darwin ] || die "macOS only."
  [ -d "$TEAMS_APP" ] || die "new Microsoft Teams not found at $TEAMS_APP."
  [ -f "$TARGET" ] || die "Teams has no client-bindings/bundle.js (version $(teams_version)); this Teams build is not supported."
}

need_node() {
  local min="${1:-$NODE_MIN}"
  command -v node >/dev/null 2>&1 || die "Node.js $min+ is required (https://nodejs.org or 'brew install node')."
  command -v pnpm >/dev/null 2>&1 || die "pnpm is required ('corepack enable pnpm' or 'brew install pnpm')."
  [ "$(node_major)" -ge "$min" ] || die "Node.js $min+ is required, found $(node --version)."
}

warn_untested() {
  case "$(teams_version)" in
    "$TESTED".*) ;;
    *) warn "Teams $(teams_version) is untested (verified on $TESTED.x). If the overlay misbehaves, run '$ME off'." ;;
  esac
}

# Stop watchers left over from an earlier `dev` (closed terminal, crash). They
# keep module paths from the old node_modules and fail with ENOENT once it is
# reinstalled, and they would fight the new session over dist-dev.
stop_stale_dev() {
  local pats=("$DIR/app/node_modules/.* build --watch" "dev\.ts $DEV_BUNDLE") p found=0
  for p in "${pats[@]}"; do
    if pgrep -f -- "$p" >/dev/null 2>&1; then found=1; pkill -f -- "$p" 2>/dev/null || true; fi
  done
  [ "$found" = 0 ] || { say "Stopped a dev session left over from earlier."; sleep 1; }
}

# Install dependencies when missing or older than the lockfile.
ensure_deps() {
  local stamp="$DIR/app/node_modules/.modules.yaml"
  if [ ! -f "$stamp" ] || [ "$DIR/app/pnpm-lock.yaml" -nt "$stamp" ]; then
    say "Installing overlay dependencies..."
    ( cd "$DIR/app" && pnpm install --frozen-lockfile --reporter=silent )
  fi
}

doctor() {
  local bad=0
  ok()   { printf '  ok    %s\n' "$*"; }
  fail() { printf '  FAIL  %s\n' "$*"; bad=1; }
  note() { printf '  note  %s\n' "$*"; }
  say "better-teams ${VERSION:-} in $DIR"
  [ "$(uname -s)" = Darwin ] && ok "macOS $(sw_vers -productVersion 2>/dev/null)" || fail "macOS only"
  if [ "$PREBUILT" = 1 ]; then
    [ -f "$PAYLOAD" ] && ok "prebuilt overlay ${VERSION:-}" || fail "prebuilt overlay missing (reinstall)"
  elif command -v node >/dev/null 2>&1; then
    if [ "$(node_major)" -ge "$NODE_MIN" ]; then ok "Node $(node --version)"; else fail "Node $(node --version); need $NODE_MIN+"; fi
    [ "$(node_major)" -ge "$NODE_DEV_MIN" ] || note "dev mode needs Node $NODE_DEV_MIN+"
  else fail "Node.js not found (need $NODE_MIN+)"; fi
  if [ "$PREBUILT" = 0 ]; then
    command -v pnpm >/dev/null 2>&1 && ok "pnpm $(pnpm --version)" || fail "pnpm not found"
  fi
  if [ -d "$TEAMS_APP" ]; then
    case "$(teams_version)" in
      "$TESTED".*) ok "Teams $(teams_version)" ;;
      *) note "Teams $(teams_version) is untested (verified on $TESTED.x)" ;;
    esac
    [ -f "$TARGET" ] && ok "client-bindings/bundle.js present" || fail "client-bindings/bundle.js missing: unsupported Teams build"
  else fail "new Microsoft Teams not found at $TEAMS_APP"; fi
  if [ "$PREBUILT" = 0 ]; then
    [ -f "$DIR/app/node_modules/.modules.yaml" ] && ok "dependencies installed" || note "dependencies not installed yet (installed on first run)"
  fi
  return $bad
}

# ---- user-level helpers ------------------------------------------------------

is_patched() { LC_ALL=C grep -qF -e "$MARK" -e "$OLD_MARK" "$TARGET" 2>/dev/null; }

# Patched payload equals the current build?
patch_current() {
  is_patched && [ -f "$PAYLOAD" ] || return 1
  local off; off="$(payload_offset)"
  cmp -s <(tail -c +"$((off + 1))" "$TARGET") "$PAYLOAD"
}

teams_running() { pgrep -x MSTeams >/dev/null 2>&1; }

quit_teams() {
  teams_running || return 0
  osascript -e "quit app \"$APP\"" >/dev/null 2>&1 || true
  for _ in $(seq 1 30); do teams_running || return 0; sleep 0.5; done
  warn "Teams did not quit within 15s; quit it manually, then start it again."
  return 1
}

port_open() { curl -s --max-time 1 "http://localhost:$PORT/json/version" >/dev/null 2>&1; }

wait_for_port() {
  for _ in $(seq 1 30); do port_open && return 0; sleep 0.5; done
  die "Teams did not open debug port $PORT within 15s"
}

# Right after a quit, LaunchServices can still list Teams as running and
# `open` fails with -600 (procNotFound) for a moment, so retry for a few seconds.
open_teams() {
  for _ in $(seq 1 10); do
    open -a "$APP" 2>/dev/null && return 0
    sleep 1
  done
  open -a "$APP"
}

launch_plain() { open_teams; }
launch_debug() { WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS="--remote-debugging-port=$PORT" open_teams; }

build() {
  if [ "$PREBUILT" = 1 ]; then
    [ -f "$PAYLOAD" ] || die "$PAYLOAD is missing; reinstall: curl -fsSL $INSTALL_URL | bash"
    return 0
  fi
  need_node
  ensure_deps
  if [ ! -f "$BUNDLE" ] || [ -n "$(find "$DIR/app/src" "$DIR/app/vite.config.ts" -newer "$BUNDLE" 2>/dev/null | head -1)" ]; then
    say "Building overlay..."; ( cd "$DIR/app" && pnpm run --silent build )
  fi
  if [ ! -f "$PAYLOAD" ] || [ "$BUNDLE" -nt "$PAYLOAD" ] || [ "$DIR/scripts/build-host-patch.ts" -nt "$PAYLOAD" ]; then
    node "$DIR/scripts/build-host-patch.ts" "$BUNDLE" "$PAYLOAD" >/dev/null
  fi
}

patch() {
  need_teams
  build
  if patch_current; then say "Teams is already patched with the current build."; return 0; fi
  warn_untested
  say "Patching Teams (administrator password needed: the app is owned by root)..."
  run_root_write patch
  patch_current || die "patch did not apply; Teams left as it was."
}

unpatch() {
  [ -f "$TARGET" ] || { say "Teams not found; nothing to restore."; return 0; }
  if ! is_patched; then say "Teams is not patched."; return 0; fi
  say "Restoring Teams' original files (administrator password needed)..."
  run_root_write restore
  is_patched && die "could not remove the patch from $TARGET"
  if codesign --verify "$TEAMS_APP" 2>/dev/null; then say "Code signature valid again."
  else warn "codesign still fails; reinstall Teams if it misbehaves."; fi
}

restart_plain() {
  say "Restarting Teams..."
  quit_teams && launch_plain
}

# Drop launcher links earlier versions put in ~/.local/bin, if they point here.
remove_old_links() {
  local l to
  for l in "${OLD_LINKS[@]}"; do
    [ -L "$l" ] || continue
    to="$(readlink "$l")"
    case "$to" in "$DIR/teams-calm" | "$DIR/better-teams") rm -f "$l"; say "Removed old launcher $l" ;; esac
  done
}

cmd="${1:-start}"
[ $# -gt 0 ] && shift
case "$cmd" in
  start)
    remove_old_links
    patch
    if port_open; then say "Teams has the debug port open; restarting without it."; fi
    restart_plain
    say "Done. Toggle the overlay with Option+Cmd+T."
    ;;
  build)
    build; say "Built $PAYLOAD"
    ;;
  patch)
    patch; say "Patched. Restart Teams to load it."
    ;;
  unpatch)
    unpatch
    ;;
  off)
    unpatch
    if teams_running; then restart_plain; else say "Teams starts without the overlay next time."; fi
    ;;
  update)
    [ "$PREBUILT" = 1 ] || die "this is a source checkout: git pull, then run ./better-teams"
    f="$(mktemp)"; trap 'rm -f "$f"' EXIT
    curl --proto '=https' -fsSL "$INSTALL_URL" -o "$f" || die "could not download $INSTALL_URL"
    bash "$f"
    ;;
  dev)
    [ "$PREBUILT" = 0 ] || die "dev mode needs a source checkout (git clone https://github.com/ph1p/better-teams)"
    need_teams; need_node "$NODE_DEV_MIN"; stop_stale_dev; ensure_deps
    say "Relaunching Teams with debug port $PORT (dev only)..."
    quit_teams || exit 1
    launch_debug; wait_for_port
    PIDS=()
    cleanup() {
      trap - INT TERM EXIT
      # ${a[@]+...}: bash 3.2 (macOS) treats an empty array as unset under -u.
      kill ${PIDS[@]+"${PIDS[@]}"} 2>/dev/null || true
      wait ${PIDS[@]+"${PIDS[@]}"} 2>/dev/null || true
      say ""; say "Leaving dev: relaunching Teams without the debug port..."
      quit_teams && launch_plain
    }
    trap cleanup INT TERM EXIT
    mkdir -p "$(dirname "$DEV_BUNDLE")"
    ( cd "$DIR/app" && exec "$DIR/app/node_modules/.bin/vite" build --watch --minify false --outDir dist-dev --logLevel warn ) & PIDS+=($!)
    node "$DIR/scripts/dev.ts" "$DEV_BUNDLE" & PIDS+=($!)
    say "Dev mode: edit app/src, the overlay reloads on save. Ctrl-C to stop."
    wait
    ;;
  status)
    say "better-teams: ${VERSION:-?} ($DIR)"
    if [ -d "$TEAMS_APP" ]; then say "Teams:      $(teams_version)$(teams_running && echo ', running' || true)"
    else say "Teams:      not installed"; fi
    if is_patched; then
      if patch_current; then say "patch:      current build"; else say "patch:      older build (run $ME)"; fi
    else say "patch:      not patched"; fi
    if port_open; then say "debug port: $PORT OPEN"; else say "debug port: closed"; fi
    ;;
  doctor)
    doctor
    ;;
  uninstall)
    purge=0
    for a in "$@"; do case "$a" in --purge) purge=1 ;; *) die "unknown option: $a" ;; esac; done
    was_running=0; teams_running && was_running=1
    unpatch
    [ "$was_running" = 1 ] && restart_plain
    remove_old_links
    if [ "$PREBUILT" = 1 ]; then
      # Only a folder this script recognises as its own release install.
      if [ -f "$DIR/VERSION" ] && [ -f "$DIR/better-teams-host.js" ]; then rm -rf "$DIR"; say "Removed $DIR."; fi
      say "Better Teams is uninstalled."
    else
      if [ "$purge" = 1 ]; then
        rm -rf "$DIR/app/node_modules" "$DIR/app/dist" "$DIR/app/dist-dev"
        say "Removed node_modules and build output."
      fi
      say "Better Teams is uninstalled. Delete $DIR to remove the source too."
    fi
    say "(Overlay preferences live in Teams' local storage and are inert without the patch.)"
    ;;
  help|-h|--help)
    usage
    ;;
  version|-v|--version)
    say "${VERSION:-unknown}"
    ;;
  *)
    usage >&2; exit 1
    ;;
esac
